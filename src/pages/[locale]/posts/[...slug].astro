---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, localeOf, slugOf, formatDate } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const entries = await getCollection('posts', (e) => !e.data.draft);
  return entries.map((entry) => ({
    params: { locale: localeOf(entry.id), slug: slugOf(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const locale = Astro.params.locale as Locale;
const _ = t(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(entry);
---
<BaseLayout locale={locale} title={entry.data.title} description={entry.data.summary} path="posts">
  <div class="wrap prose">
    <div class="meta muted">{formatDate(entry.data.date, locale)} · {entry.data.author}</div>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.summary}</p>
    <hr />
    <Content />
    <hr />
    <p>{entry.data.tags.map((tag) => <span class="tag" style="margin-right:.35rem">{tag}</span>)}</p>
    <p><a href={`${base}/${locale}/posts/`}>← {_('common.backto')} {_('nav.posts')}</a></p>
  </div>
</BaseLayout>
