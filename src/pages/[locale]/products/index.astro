---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Card from '../../../components/Card.astro';
import { t, localeOf, slugOf } from '../../../i18n/utils';
import { locales, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const _ = t(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = (await getCollection('products', (e) => localeOf(e.id) === locale))
  .sort((a, b) => a.data.order - b.data.order);

const categories = [...new Set(entries.map((e) => e.data.category))];
---
<BaseLayout locale={locale} title={_('nav.products')} path="products">
  <div class="wrap">
    <h1>{_('nav.products')}</h1>
    {categories.map((cat) => (
      <section>
        <h2>{cat}</h2>
        <div class="grid">
          {entries.filter((e) => e.data.category === cat).map((e) => (
            <Card
              title={e.data.title}
              href={`${base}/${locale}/products/${slugOf(e.id)}/`}
              meta={e.data.model}
              tag={_(`status.${e.data.status}` as any)}
              summary={e.data.summary}
            />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
